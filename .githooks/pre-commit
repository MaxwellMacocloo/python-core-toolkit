#!/bin/sh
# Refuse commits authored or committed under an AI identity.
for var in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  if git var "$var" | grep -qiE 'claude|anthropic'; then
    echo "pre-commit: $var is '$(git var "$var" | sed 's/>.*/>/')'." >&2
    echo "Set git user.name/user.email to your own identity before committing." >&2
    exit 1
  fi
done
